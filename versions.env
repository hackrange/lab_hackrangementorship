# Every version the Mentorship Local Lab installs, in one place.
#
# These match what the hosted course labs run, so a lesson behaves the same on
# a student's own machine as it does in the browser lab.  Change one only on
# purpose, and test the lessons that use it afterward.
#
# Author: Tim Rice

# The web desktop, the way a student opens a lab in a browser.  1.6.0, not
# latest: latest is published for amd64 only, and 1.6.0 has arm64 as well.
GUACAMOLE_IMAGE="guacamole/guacamole:1.6.0"
GUACD_IMAGE="guacamole/guacd:1.6.0"

# The DAST scanner for the Week 11 challenge, built from its public source.
# The hosted labs pull a prebuilt image from a private registry, which a
# student cannot reach, so this builds the same version from the repository.
# The sidecar image layered on top of it bundles its own database, so there is
# no second service to run.
DAST_REPO="https://git.hackrange.com/trice/nextgen-dast.git"
DAST_REF="2.1.1"
DAST_BASE_IMAGE="nextgen-dast:2.1.1"

# The lab images, built on this machine.  Each is listed in config/labs.conf
# against the course weeks that use it.
KALI_SSH_IMAGE="kali-lab-ssh:latest"
NETLAB_IMAGE="netlab:latest"
ANALYST_IMAGE="analyst-lab:latest"
SPLUNK_IMAGE="splunk-lab:latest"
WEBAPP_IMAGE="webapp-lab:latest"
WEBAPP_GUI_IMAGE="mentorship-webapp-gui:latest"
CLOUD_AUDIT_IMAGE="cloud-audit-lab:latest"
DAST_LAB_IMAGE="nextgen-dast-lab:latest"

# Splunk, for the Week 8-10 labs.  The image downloads this build from
# Splunk's own site; keep it in step with what the lessons show.
SPLUNK_VERSION="9.3.2"
SPLUNK_BUILD="d8bb32809498"
