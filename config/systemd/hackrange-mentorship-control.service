# The Local Lab control panel: the labs, start and stop, and resource use.
# Author: Tim Rice - tim.j.rice@hackrange.com
[Unit]
Description=Hackrange Mentorship Local Lab control panel
After=network-online.target docker.service nginx.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/hackrange-mentorship/control/server.py
Restart=always
RestartSec=5
User=root
# Root, because it starts and stops the lab and reads the lab password, which
# is deliberately readable only by an administrator.  Fenced in otherwise.
#
# ProtectHome is NOT set: hackrange-check marks work that lives in the
# student's home directory inside the lab, and the launcher reads this
# machine's own home directories to put a desktop shortcut there.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
