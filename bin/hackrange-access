#!/usr/bin/env bash
# How a student gets into their Local Lab, and the one password that does it.
#
#   hackrange-access rotate   make a new password (every new lab session)
#   hackrange-access cert     refresh the web address's certificate for this
#                             machine's current network addresses
#   hackrange-access info     print the web address, SSH command and password
#
# One username (student) and one password open all three ways in: the web
# desktop in a browser, SSH, and Remote Desktop.  The password is replaced
# every time a lab session is started fresh and on every install, so a
# password a student pasted somewhere, or a lab they exposed by accident, stops
# working the next time they start a session.  It is stored readable by root
# only; the guacamole service reads its own copy.
#
# Runs as root (hackrange-lab calls it through sudo).
#
# Author: Tim Rice - tim.j.rice@hackrange.com
set -euo pipefail

HR_ETC=/etc/hackrange-mentorship
HR_ROOT=/opt/hackrange-mentorship
ACCESS="$HR_ETC/access.env"
GUAC_DIR="$HR_ETC/guacamole"
LABTLS=/etc/nginx/mentorship-tls
CA_DIR="$HR_ETC/ca"
WEB_PORT=8456
SSH_PORT=2223
RDP_PORT=13489
LAB_CONTAINER=hackrange-mentorship-lab
CATALOG="$HR_ROOT/config/labs.conf"
STATE="$HR_ETC/current-lab"
GUAC_GROUP=hackrange-mentorship-guac   # a system group; the guacamole container is given it (compose group_add)

# Which lab is running, and how it is opened.  This course has seven labs and
# four of them are terminals rather than desktops, so the web desktop has to
# offer the protocol the running lab actually speaks.  A single rdp connection
# would open a black window for every terminal lab.
current_lab()  { [ -r "$STATE" ] && cat "$STATE" 2>/dev/null || echo ""; }
lab_row()      { grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$CATALOG" 2>/dev/null | awk -F'|' -v k="$1" '$1==k {print; exit}'; }
lab_protocol() { local r; r="$(lab_row "$(current_lab)")"; [ -n "$r" ] && echo "$r" | cut -d'|' -f3 || echo rdp; }
lab_title()    { local r; r="$(lab_row "$(current_lab)")"; [ -n "$r" ] && echo "$r" | cut -d'|' -f7 || echo "Hackrange Mentorship Lab"; }
# The web apps inside the running lab, as port/Label rows.  Empty for most
# labs, deliberately: config/labs.conf says why.
lab_web()      { local r; r="$(lab_row "$(current_lab)")"; [ -n "$r" ] || return 0
                 local w; w="$(echo "$r" | cut -d'|' -f8)"
                 [ -n "$w" ] && [ "$w" != "-" ] || return 0
                 printf '%s\n' "$w" | tr ',' '\n'; }

[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"

# ---------------------------------------------------------------- addresses

# This machine's address on its network: the one a student's own computer
# reaches it on.  Empty when the machine has no network.
primary_ip() { ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1 || true; }

# Every IPv4 address the machine has, except loopback and the lab's own.
# Docker's and Kubernetes' own bridges are left out: nothing outside this
# machine can reach them, so naming them would only clutter the certificate.
all_ips() {
    ip -4 -o addr show | awk '$2 !~ /^(lo|lab0|docker[0-9]*|br-.*|cni[0-9]*|flannel.*|veth.*|kube.*|vxlan.*)$/ {
        split($4, a, "/"); print a[1] }'
}

# Private (home, office, virtual machine) addresses, as opposed to ones on the
# public internet.  nginx refuses everything else at the door.
is_private() {
    case "$1" in
        10.*|192.168.*|127.*|169.254.*) return 0 ;;
        172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
        100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 0 ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------- password

# Four groups of four, from letters and digits that cannot be mistaken for one
# another (no 0/O, 1/l/I), so a beginner can read it off the screen and type it:
# about 80 bits, far beyond guessing even if the lab is exposed.
new_password() {
    local chars='abcdefghjkmnpqrstuvwxyz23456789' pw='' i
    for i in $(seq 1 16); do
        pw+="${chars:$(( $(od -An -N2 -tu2 /dev/urandom) % ${#chars} )):1}"
        [ $((i % 4)) -eq 0 ] && [ "$i" -lt 16 ] && pw+='-'
    done
    printf '%s' "$pw"
}

# Nothing, and success, before the first lab session: the file does not exist
# yet.  The guard matters because sed's "can't read" status is 2, and under
# set -e that killed the caller before it could say "no lab started yet".
password() {
    [ -r "$ACCESS" ] || return 0
    sed -n 's/^LAB_ACCESS_PASSWORD=//p' "$ACCESS" 2>/dev/null
}

xml_escape() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'; }

rotate() {
    local pw; pw="$(new_password)"
    install -d -m 700 "$HR_ETC"
    ( umask 077; printf '# The lab login password.  Replaced at every new session.\nLAB_ACCESS_PASSWORD=%s\n' "$pw" > "$ACCESS.tmp" )
    mv "$ACCESS.tmp" "$ACCESS"

    # The web desktop's login, and the Remote Desktop connection it opens.  The
    # guacamole service notices the change within seconds: no restart.
    # A dedicated system group, not the image's own group id: on the host that
    # number is usually a real person's group (the second account made).
    getent group "$GUAC_GROUP" >/dev/null || groupadd --system "$GUAC_GROUP"
    install -d -m 750 "$GUAC_DIR"
    chown root:"$GUAC_GROUP" "$GUAC_DIR"
    local x; x="$(xml_escape "$pw")"
    ( umask 027
      local proto name
      proto="$(lab_protocol)"
      # A FIXED name, deliberately, not the lab's title.  Guacamole builds the
      # address of a session from the connection's name, so a name that changed
      # with the lab gave every lab a different address: a student who
      # bookmarked the lab, or followed a link from the lesson, found it had
      # stopped existing the moment they started a different one.  Which lab is
      # running is shown by the panel and by "hackrange-lab status" instead.
      name="Hackrange Mentorship Lab"
      if [ "$proto" = ssh ]; then
          # A terminal lab.  Guacamole opens it over SSH, so the student gets a
          # real terminal in the browser rather than an empty desktop.
          cat > "$GUAC_DIR/user-mapping.xml.tmp" <<EOF
<user-mapping>
  <authorize username="student" password="$x">
    <connection name="$name">
      <protocol>ssh</protocol>
      <param name="hostname">$LAB_CONTAINER</param>
      <param name="port">22</param>
      <param name="username">student</param>
      <param name="password">$x</param>
      <param name="font-size">12</param>
      <param name="color-scheme">gray-black</param>
      <param name="scrollback">10000</param>
    </connection>
  </authorize>
</user-mapping>
EOF
      else
          cat > "$GUAC_DIR/user-mapping.xml.tmp" <<EOF
<user-mapping>
  <authorize username="student" password="$x">
    <connection name="$name">
      <protocol>rdp</protocol>
      <param name="hostname">$LAB_CONTAINER</param>
      <param name="port">3389</param>
      <param name="username">student</param>
      <param name="password">$x</param>
      <param name="security">any</param>
      <param name="ignore-cert">true</param>
      <param name="resize-method">display-update</param>
      <param name="enable-font-smoothing">true</param>
      <param name="disable-audio">true</param>
    </connection>
  </authorize>
</user-mapping>
EOF
      fi
    )
    chown root:"$GUAC_GROUP" "$GUAC_DIR/user-mapping.xml.tmp"
    chmod 640 "$GUAC_DIR/user-mapping.xml.tmp"
    mv "$GUAC_DIR/user-mapping.xml.tmp" "$GUAC_DIR/user-mapping.xml"
}

# ---------------------------------------------------------------- certificate

# The web desktop's certificate names every address this machine has, so it
# matches whichever one the student types.  Addresses change (a new network, a
# new DHCP lease), so this runs at every boot and every session start, and only
# re-issues when an address is missing.
cert() {
    local crt="$LABTLS/lab-access.crt" key="$LABTLS/lab-access.key" ips ip need=0 san
    ips="$(all_ips)"
    if [ ! -s "$crt" ] || ! openssl x509 -checkend $((30 * 86400)) -noout -in "$crt" >/dev/null 2>&1; then
        need=1
    else
        for ip in $ips; do
            is_private "$ip" || continue
            openssl x509 -noout -ext subjectAltName -in "$crt" 2>/dev/null | grep -q "IP Address:$ip\b" || need=1
        done
    fi
    [ "$need" = 1 ] || return 0

    # Only names and addresses the lab CA may vouch for (its name constraints,
    # scripts/40-certs.sh): localhost, the machine name the CA was made with,
    # and private addresses, which are the only ones nginx serves anyway.
    local host; host="$(hostname -s | tr 'A-Z' 'a-z')"
    san="DNS:localhost,IP:127.0.0.1"
    if [ ! -s "$CA_DIR/permitted-host" ] || [ "$(cat "$CA_DIR/permitted-host")" = "$host" ]; then
        san="$san,DNS:$host"
    fi
    for ip in $ips; do is_private "$ip" && san="$san,IP:$ip"; done
    local tmp; tmp="$(mktemp -d)"
    printf 'basicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature,keyEncipherment\nextendedKeyUsage=serverAuth\nsubjectAltName=%s\n' \
        "$san" > "$tmp/ext.cnf"
    openssl req -newkey rsa:2048 -nodes -keyout "$tmp/key" -out "$tmp/csr" \
        -subj "/O=Hackrange Labs/CN=Hackrange Mentorship Lab ($(hostname -s))" >/dev/null 2>&1
    openssl x509 -req -in "$tmp/csr" -CA "$CA_DIR/lab-ca.crt" -CAkey "$CA_DIR/lab-ca.key" \
        -CAcreateserial -CAserial "$CA_DIR/lab-ca.srl" -days 825 -sha256 \
        -extfile "$tmp/ext.cnf" -out "$tmp/crt" >/dev/null 2>&1
    install -m 600 "$tmp/key" "$key"
    install -m 644 "$tmp/crt" "$crt"
    rm -rf "$tmp"
    systemctl reload nginx 2>/dev/null || true
}

# ---------------------------------------------------------------- information

info() {
    local ip pw fp
    ip="$(primary_ip)"
    pw="$(password)"
    local b=$'\e[1m' g=$'\e[32m' y=$'\e[33m' o=$'\e[0m'
    [ -t 1 ] || { b=''; g=''; y=''; o=''; }

    printf '\n%s==================================================================%s\n' "$g$b" "$o"
    printf '%s  Your Hackrange Local Lab%s\n' "$g$b" "$o"
    printf '%s==================================================================%s\n\n' "$g$b" "$o"

    if [ -z "$pw" ]; then
        printf '  No lab password yet.  Start a lab session:  hackrange-lab start <lab>\n\n'
        return
    fi

    # The panel first, because it is the one address that answers every
    # question below it: it shows this password, what the machine is doing, and
    # a button for each lab.  Everything after it is for a student who would
    # rather type than click, which is why none of it was removed.
    printf '%s  The lab control panel  (start a lab, open it, see how it is doing)%s\n' "$b" "$o"
    if [ -n "$ip" ] && is_private "$ip"; then
        printf '      From your own computer:   https://%s:%s/control/\n' "$ip" "$WEB_PORT"
    fi
    printf '      From this Ubuntu machine: https://127.0.0.1:%s/control/\n\n' "$WEB_PORT"

    printf '%s  Or open the lab in a web browser%s\n' "$b" "$o"
    if [ -n "$ip" ] && is_private "$ip"; then
        printf '      From your own computer:   https://%s:%s\n' "$ip" "$WEB_PORT"
    fi
    printf '      From this Ubuntu machine: https://127.0.0.1:%s\n\n' "$WEB_PORT"

    printf '%s  Sign in with%s\n' "$b" "$o"
    printf '      username:  student\n'
    printf '      password:  %s%s%s\n\n' "$b" "$pw" "$o"

    printf '%s  Connect with SSH%s  (same username and password)\n' "$b" "$o"
    if [ -n "$ip" ] && is_private "$ip"; then
        printf '      From your own computer:   ssh -p %s student@%s\n' "$SSH_PORT" "$ip"
    fi
    printf '      From this Ubuntu machine: ssh -p %s student@127.0.0.1\n' "$SSH_PORT"
    printf '      The first time, type  yes  and press Enter.  Nothing shows on the\n'
    printf '      screen while you type the password; that is normal.\n\n'

    printf '%s  Or any Remote Desktop app%s  (same username and password)\n' "$b" "$o"
    printf '      address:  %s:%s\n\n' "${ip:-127.0.0.1}" "$RDP_PORT"

    # The running lab's own web app, opened straight from the student's browser
    # rather than through the lab's desktop.  On an ARM machine this is the
    # difference between a usable Splunk lab and an unusable one, because
    # Splunk has no ARM build and the lab's own Firefox runs emulated.
    local wspec wport wlabel shown=0
    while IFS= read -r wspec; do
        [ -n "$wspec" ] || continue
        wport="${wspec%%/*}"; wlabel="${wspec#*/}"
        [ "$wlabel" = "$wspec" ] && wlabel="the lab's web app"
        if [ "$shown" -eq 0 ]; then
            printf '%s  %s, in your own browser%s\n' "$b" "$wlabel" "$o"
            shown=1
        fi
        if [ -n "$ip" ] && is_private "$ip"; then
            printf '      From your own computer:   http://%s:%s/\n' "$ip" "$wport"
        fi
        printf '      From this Ubuntu machine: http://127.0.0.1:%s/\n' "$wport"
    done <<< "$(lab_web)"
    if [ "$shown" -eq 1 ]; then
        printf '      Its own login is separate from the one above:  hackrange-lab env\n'
        printf '      This is plain http, so use it only on your own network.\n\n'
    fi

    # No lab services here.  Every lab in this course is a self contained
    # machine: the logins a lesson needs belong to whatever is running INSIDE
    # the lab (Splunk, the DAST scanner), so they come from the lab itself
    # rather than from a list of services on this machine.
    printf '%s  The lab'"'"'s own logins%s\n' "$b" "$o"
    printf '      Splunk, the scanner and anything else a lesson signs in to:\n'
    printf '          hackrange-lab env\n\n'

    printf '%s  Good to know%s\n' "$b" "$o"
    printf '    - The first time, your browser warns that the connection is not\n'
    printf '      private.  That is because the lab uses its own certificate, which\n'
    printf '      your browser has not met.  For THIS address only, choose\n'
    printf '      "Advanced" and then "Continue" (or "Accept the risk").  Never do\n'
    printf '      that for a bank, email or shopping site.  The README shows how to\n'
    printf '      make the warning go away for good.\n'
    # Only if it can actually be read.  Telling a beginner to check a
    # fingerprint and then showing them a blank line teaches them to skip the
    # check, which is worse than not mentioning it.
    # The "|| true" is not decoration: under set -euo pipefail a missing CA
    # makes this assignment fatal, which is the very failure this block is
    # here to avoid.
    fp="$(openssl x509 -noout -fingerprint -sha256 -in "$LABTLS/lab-ca.crt" 2>/dev/null | cut -d= -f2 || true)"
    if [ -n "$fp" ]; then
        printf '    - The lab certificate'"'"'s fingerprint (check it before you trust it):\n'
        printf '      %s\n' "$fp"
    fi
    printf '    - Some lessons use addresses that only work INSIDE the lab, such\n'
    printf '      as http://portal.lab:5000 in the Week 11 challenge.  Open those\n'
    printf '      from the lab'"'"'s own desktop or terminal, not from your computer.\n'
    printf '    - This password changes every time you start a new lab session, and\n'
    printf '      after every install.  To see the current one again, run:\n'
    printf '          /opt/hackrange-mentorship/show_information.sh\n'
    printf '    - Keep the password to yourself.  Do not post it in a chat, a forum\n'
    printf '      or a screenshot.  If you think someone saw it, run\n'
    printf '          hackrange-lab reset\n'
    printf '      and it is replaced.  (That restarts the lab, so anything inside\n'
    printf '      it is lost; copy out what you want to keep first.)\n'
    printf '    - The lab only answers computers on your own private network, never\n'
    printf '      the internet.  Do not forward these ports on your router.\n'

    if [ -n "$ip" ] && ! is_private "$ip"; then
        printf '\n%s  Note:%s this machine is directly on the internet (%s).  For your\n' "$y$b" "$o" "$ip"
        printf '  safety the lab refuses connections from the internet, so open it from\n'
        printf '  this machine, or reach it through an SSH tunnel (see the README).\n'
    fi
    printf '\n'
}

case "${1:-info}" in
    rotate) rotate ;;
    cert)   cert ;;
    info)   info ;;
    *) echo "usage: hackrange-access rotate|cert|info" >&2; exit 2 ;;
esac
